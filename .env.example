# Configuración de Supabase para VozComún
# Reemplaza estos valores con los que encuentras en el panel de Supabase:
# Settings > API > Project URL & anon/public key

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Nombre del bucket de almacenamiento para audios (por defecto: audios)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=audios

# Límite máximo de tamaño de archivo en bytes (20 MB = 20971520 bytes)
NEXT_PUBLIC_MAX_AUDIO_SIZE_BYTES=20971520

# Duración máxima en segundos (10 minutos = 600 segundos)
NEXT_PUBLIC_MAX_AUDIO_DURATION_SECONDS=600

